{
  "name": "carbud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/bundle-migrations.mjs && next build",
    "start": "next start",
    "postinstall": "node scripts/allow-next15.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=sites",
    "deploy": "webflow cloud deploy",
    "preview": "node scripts/bundle-migrations.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "db:apply:local": "wrangler d1 migrations apply DB --local",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:apply:remote": "node scripts/migrate-remote.mjs",
    "dev:sites": "npm run dev --workspace=sites",
    "build:sites": "npm run build --workspace=sites"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "lucide-react": "^1.33.0",
    "next": "^15.2.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250415.0",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.6.5",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^15.2.8",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.11.1"
  },
  "workspaces": [
    "packages/*",
    "sites"
  ]
}
